msgid "quote_6"
msgstr "粗缯大布裹生涯，腹有诗书气自华。"

msgid "quote_7"
msgstr "灯火纸窗修竹里，读书声。"

msgid "quote_8"
msgstr "读万卷书，行万里路。"
