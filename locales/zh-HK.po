msgid "quote_5"
msgstr "黑髮不知勤學早，白首方悔讀書遲。"

msgid "quote_6"
msgstr "粗繒大布裹生涯，腹有詩書氣自華。"

msgid "quote_7"
msgstr "燈火紙窗修竹裡，讀書聲。"

msgid "quote_8"
msgstr "讀萬卷書，行萬里路。"
